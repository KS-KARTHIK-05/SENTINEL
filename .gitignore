# ROS 2 Build and Install Artifacts
build/
install/
log/
.catkin_tools/

# Python compiled files and packaging metadata (editable installs)
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.venv/
venv/

# Large ML Weights & Datasets
datasets/
HIT-UAV/
*.jpg
*.jpeg
*.png
*.mp4
# the README figures and the victim model's textures are kept
!docs/figures/*.png
!sentinel_ws/src/sentinel_gazebo/models/rescue_randy_thermal/materials/textures/*.png

# Weights downloaded by Ultralytics and its run folders; only the trained weights in
# sentinel_ws/src/sentinel_ai/models/ are kept
*.pt
*.onnx
*.engine
!sentinel_ws/src/sentinel_ai/models/*.pt
!sentinel_ws/src/sentinel_ai/models/*.onnx
runs/

# Results, logs, pilots and archives live outside the repository (~/sentinel_ws/results)
results/
handover/
*.parquet
*.log
*.zip
*.tar.gz

# OS specific files
.DS_Store

# Reviews and response letters are confidential: never commit them
response_to_reviewers.*
*reviews*

# LaTeX build files of the ICIUS paper (main.pdf and main_highlighted.pdf are kept)
paper_icius_ios/*.aux
paper_icius_ios/*.log
paper_icius_ios/*.fls
paper_icius_ios/*.fdb_latexmk
paper_icius_ios/*.blg
paper_icius_ios/*.out
# template documentation shipped with the IOS zip (not needed to build)
paper_icius_ios/ios-book-article_LaTeX_Instructions.pdf
